  "execution_rules": {
    "description": "交易执行规则",
    "limit_orders": {
      "overnight": {
        "slippage": 0.02,
        "fill_probability": 0.3,
        "timeout": 300
      },
      "pre_market": {
        "slippage": 0.015,
        "fill_probability": 0.5,
        "timeout": 180
      },
      "regular": {
        "slippage": 0.005,
        "fill_probability": 0.9,
        "timeout": 60
      },
      "after_hours": {
        "slippage": 0.02,
        "fill_probability": 0.4,
        "timeout": 240
      }
    },
    "market_orders": {
      "warning": "仅在流动性充足时使用",
      "allowed_sessions": ["regular", "pre_market"],
      "max_size": 100
    }
  },

  "monitoring_alerts": {
    "description": "监控和警报",
    "liquidity_alerts": {
      "threshold": 10000,
      "sessions": ["overnight", "after_hours"]
