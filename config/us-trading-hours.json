      {
        "time": "16:05",
        "name": "盘后开盘扫描",
        "frequency": "每30分钟",
        "purpose": "盘后财报/新闻反应"
      },
      {
        "time": "18:00",
        "name": "盘后尾盘扫描",
        "frequency": "每小时",
        "purpose": "盘后结束前检查"
      }
    ]
  },

  "strategy_adjustments": {
    "description": "不同时段的策略调整",
    "overnight": {
      "risk_multiplier": 0.8,
      "position_size": 0.6,
      "stop_loss": 0.04,
      "take_profit": 0.08,
      "preferred_indicators": ["ATR", "Volume", "VWAP"],
      "avoid_strategies": ["Mean Reversion", "High Frequency"]
    },
    "pre_market": {
      "risk_multiplier": 0.9,
      "position_size": 0.8,
      "stop_loss": 0.03,
      "take_profit": 0.06,
      "preferred_indicators": ["Gap", "Pre-market Volume", "News Sentiment"],
      "avoid_strategies": ["Trend Following"]
    },
    "regular": {
      "risk_multiplier": 1.0,
      "position_size": 1.0,
      "stop_loss": 0.02,
      "take_profit": 0.04,
      "preferred_indicators": ["All Technical Indicators", "Market Breadth"],
      "avoid_strategies": []
    },
    "after_hours": {
      "risk_multiplier": 0.7,
      "position_size": 0.5,
      "stop_loss": 0.05,
      "take_profit": 0.10,
      "preferred_indicators": ["Earnings Reaction", "News Impact", "Volume Spike"],
      "avoid_strategies": ["Technical Analysis", "Swing Trading"]
    }
  },

  "data_feed_config": {
    "description": "不同时段的数据源配置",
    "overnight": {
      "primary_data": "Futu OpenD (real-time)",
      "secondary_data": "Yahoo Finance (delayed)",
      "news_sources": ["Reuters Night", "Asian Markets"],
      "update_frequency": "1 minute"
    },
    "pre_market": {
      "primary_data": "Futu OpenD (real-time)",
      "secondary_data": "AlphaVantage",
