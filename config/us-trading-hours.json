  "scanning_schedule": {
    "description": "市场扫描时间表",
    "scans": [
      {
        "time": "22:05",
        "name": "夜盘开盘扫描",
        "frequency": "每小时",
        "purpose": "夜盘开盘波动性扫描"
      },
      {
        "time": "04:05",
        "name": "盘前开盘扫描",
        "frequency": "每30分钟",
        "purpose": "盘前重要消息反应"
      },
      {
        "time": "09:35",
        "name": "盘中开盘扫描",
        "frequency": "每15分钟",
        "purpose": "开盘30分钟关键期"
      },
      {
        "time": "12:00",
        "name": "午间扫描",
        "frequency": "每小时",
        "purpose": "午间流动性扫描"
      },
      {
        "time": "15:30",
        "name": "收盘前扫描",
        "frequency": "每10分钟",
