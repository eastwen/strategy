{
  "version": "1.1",
  "updated": "2026-03-25",
  "name": "美股全时段交易时间配置",
  "description": "支持夜盘、盘前、盘中、盘后全时段交易",
  
  "trading_sessions": {
    "description": "美股交易时段划分",
    "sessions": {
      "overnight": {
        "name": "夜盘",
        "time_range": ["22:00", "04:00"],
        "next_day": true,
        "description": "夜盘交易时段，对应次日交易",
        "market_condition": "低流动性，高波动性",
        "suitable_for": ["日内短线", "突破交易"],
        "position_limit": 0.5,
        "commission_multiplier": 1.2
      },
      "pre_market": {
        "name": "盘前",
        "time_range": ["04:00", "09:30"],
        "description": "盘前交易时段",
        "market_condition": "中等流动性，反应隔夜消息",
        "suitable_for": ["消息反应交易", "gap fill"],
        "position_limit": 0.7,
        "commission_multiplier": 1.1
      },
      "regular": {
        "name": "盘中",
        "time_range": ["09:30", "16:00"],
        "description": "常规交易时段",
        "market_condition": "高流动性，正常波动",
        "suitable_for": ["趋势交易", "均值回归", "所有策略"],
        "position_limit": 1.0,
        "commission_multiplier": 1.0
      },
      "after_hours": {
        "name": "盘后",
        "time_range": ["16:00", "20:00"],
        "description": "盘后交易时段",
        "market_condition": "中等流动性，反应财报/新闻",
        "suitable_for": ["财报交易", "新闻反应"],
        "position_limit": 0.6,
        "commission_multiplier": 1.15
      }
    }
  },

