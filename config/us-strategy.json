  "llm_analysis": {
    "enabled": true,
    "model": "deepseek-r1",
    "min_base_score_for_llm": 70,
    "min_final_score": 65,
    "description": "扫描后TOP50候选股票进行LLM分析，基础评分≥70才分析，最终评分≥65才考虑入场",
    "adjustment_range": 10,
    "positive_bonus": "+5分（技术面强劲+新闻正面）",
    "negative_penalty": "-5分（技术面疲弱+新闻负面）"
  },
  "sentiment_monitoring": {
    "vix_fear_index": {
      "code": "US.VIX",
      "weight": 0.3,
      "thresholds": {
        "extreme_fear": 30,
        "fear": 25,
        "normal": 20,
        "calm": 15
      }
    },
    "cnn_fear_greed": {
      "source": "CNN API",
      "weight": 0.25,
      "thresholds": {
        "extreme_fear": 25,
        "fear": 45,
        "neutral": 55,
        "greed": 75,
        "extreme_greed": 100
      }
    },
    "option_ratio": {
      "source": "get_option_chain",
      "weight": 0.25,
      "thresholds": {
        "bullish": 1.2,
        "neutral": 1.0,
        "bearish": 0.8
      }
    },
    "news_sentiment": {
      "source": "news_integration.py",
      "weight": 0.2
    }
  },
  "trading_conditions": {
    "entry_conditions": [
      "趋势向上: MA20 > MA50，价格 > MA20",
      "技术信号≥2 或 信号≥1+强背离",
      "成交量放大 ≥ 1.8x",
      "RSI < 65",
      "LLM最终评分 ≥ 65分"
    ],
    "exit_conditions": [
      "ATR动态止损（1.8-2.0x）",
      "ATR动态止盈（4.0-4.5x）",
      "RSI超买离场（>70）",
      "MACD死叉离场",
      "最大持仓6天"
